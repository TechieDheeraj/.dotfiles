{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Muted slate terminal tab-bar separators and horizontal/vertical pane
  // dividers. activePaneBorderColor stays unset so no outline covers cells.
  "paneBorderColor": "#475569",

  // Migrated from ~/.config/kitty/kitty.conf on 2026-07-29.
  // Kitty tabs map most closely to cmux workspaces; Kitty windows map
  // most closely to cmux panes.
  "app": {
    // Kitty used its black terminal background for the macOS title bar.
    "appearance": "dark",
    "minimalMode": false,
    "confirmQuit": "never",
    "warnBeforeClosingTab": false
  },

  "terminal": {
    "showScrollBar": false
  },

  "sidebarAppearance": {
    // Keep the workspace sidebar nearly black, but distinct from the terminal's
    // pure #000000 background. cmux does not expose its sidebar hairline color.
    "matchTerminalBackground": false,
    "tintColor": "#101010",
    "darkModeTintColor": "#101010",
    "tintOpacity": 1.0
  },

  "automation": {
    // Closest safe equivalent to Kitty allow_remote_control=yes without
    // configuring a public listen socket: descendants of cmux may connect.
    "socketControlMode": "cmuxOnly"
  },

  "shortcuts": {
    "bindings": {
      // Terminal tabs/surfaces inside the currently focused pane.
      "prevSurface": "cmd+shift+p",
      "nextSurface": "cmd+shift+n",

      // Workspace navigation.
      "newTab": "cmd+shift+t",
      "prevSidebarTab": "cmd+shift+[",
      "nextSidebarTab": "cmd+shift+]",
      // cmux expands this to Cmd-1…9. In 0.64.20, 9 means "last";
      // there is no numbered workspace-10 action.
      "selectWorkspaceByNumber": "cmd+1",
      "closeWorkspace": "cmd+shift+w",

      // Preserve access to cmux features displaced by the Kitty bindings.
      "newWindow": "cmd+opt+shift+n",
      "commandPalette": "cmd+opt+p",
      "reopenClosedBrowserPanel": null,

      // Kitty window-style pane/surface controls.
      "closeTab": "cmd+w",
      // Close the entire cmux application.
      "quit": "cmd+q",
      "splitRight": "cmd+d",
      "splitDown": "cmd+shift+d",
      "toggleSplitZoom": "cmd+shift+return",
      "equalizeSplits": "cmd+shift+/",

      // Let the Ghostty layer handle Kitty's cyclic pane and word-motion keys.
      "markWorkspaceDone": null,
      "cycleWorkspaceStatus": null
    }
  },

